#!/bin/sh
# Every check a change must pass before it is pushed: compile, format, both
# Rust programs, then the product and lab tests. Stops at the first failure.
set -eu
cd "$(dirname "$0")/.."
# Golden tests rewrite their files instead of comparing when this is set.
unset ELARA_UPDATE_GOLDENS

step() { printf '\n==> %s\n' "$*"; }

descriptor_limit=$(ulimit -S -n)
case "$descriptor_limit" in
  unlimited) ;;
  *)
    if [ "$descriptor_limit" -lt 4096 ]; then
      if ! ulimit -S -n 4096; then
        printf 'bin/check requires a file-descriptor hard limit of at least 4096; current hard limit: %s\n' "$(ulimit -H -n)" >&2
        exit 1
      fi
    fi
    ;;
esac
step "file descriptors: soft limit $(ulimit -S -n) (suite requires at least 4096)"

step "mix compile --warnings-as-errors"
mix compile --warnings-as-errors

step "lab: mix compile --warnings-as-errors"
(cd lab && mix compile --warnings-as-errors)

step "mix format --check-formatted"
mix format --check-formatted

step "lab: mix format --check-formatted"
(cd lab && mix format --check-formatted)

for crate in native/exec-stub native/elara-tui; do
  step "$crate: cargo fmt --check, clippy, test"
  (cd "$crate" && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && cargo test --locked) || exit
done

step "mix test"
mix test

step "lab: mix test"
(cd lab && mix test)

printf '\nAll checks passed.\n'
